{
  "name": "wallet-sanctions-risk-screener",
  "version": "0.1.0",
  "description": "OFAC SDN + scam/phishing registries + live on-chain contract reads + wallet age/tx history, resolved into one scored verdict per address.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "apify": "^3.2.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.6.0"
  }
}
